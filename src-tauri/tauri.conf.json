{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Agente Pedro",
  "version": "0.1.0",
  "identifier": "com.pedro.agente-pedro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Agente Pedro - Ilha",
        "width": 404,
        "height": 72,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "visible": true,
        "url": "index.html?window=island",
        "focus": false,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "Agente Pedro",
        "width": 1280,
        "height": 820,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false,
        "center": true,
        "url": "index.html?window=main",
        "minWidth": 760,
        "minHeight": 600
      },
      {
        "label": "dock",
        "title": "Agente Pedro - Atalhos",
        "width": 450,
        "height": 88,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "url": "index.html?window=dock"
      },
      {
        "label": "top-left",
        "title": "Agente Pedro - Controles",
        "width": 128,
        "height": 46,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "url": "index.html?window=top-left"
      },
      {
        "label": "top-right",
        "title": "Agente Pedro - Volume",
        "width": 90,
        "height": 46,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "url": "index.html?window=top-right"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
